# Copy to .env (gitignored) and fill in. Never commit .env.
# Read by bootstrap/scripts/*.sh and the Makefile (see SPEC §2.4).

# GitOps repository that Argo CD watches (Phase 3+). Private repo => GITHUB_TOKEN required.
GITOPS_REPO_URL=https://github.com/johnnreborn/minikube
GITOPS_REVISION=main
# fine-grained token, repository "Contents: read-only" only. Leave empty for a public repo.
GITHUB_TOKEN=

# Grafana admin password, turned into observability/Secret `grafana-admin` by gitops-bootstrap.sh (Phase 7)
GRAFANA_ADMIN_PASSWORD=

# Docker network for kind. If it collides with a VPN/corporate range, change it AND the LB pool in manifests.
DOCKER_SUBNET=172.30.0.0/16
