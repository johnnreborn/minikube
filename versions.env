# versions.env — single source of truth for every tool / chart / image version (CLAUDE.md, SPEC §5.1).
# Verified 2026-11-25 against the sources named on each entry.
# Rules: no `latest`, no ranges (^ ~ x), kind node image pinned with @sha256.
# `make lint` (scripts/check-versions.sh) compares this file with Application targetRevision,
# bootstrap scripts and kind config. Plain KEY=VALUE only (sourced by bash and read by make).

# ---- CLI tools -------------------------------------------------------------------------------
# https://github.com/kubernetes-sigs/kind/releases/tag/v0.33.0
KIND_VERSION=v0.33.0
# https://dl.k8s.io/release/stable-1.36.txt (kubectl follows the cluster minor)
KUBECTL_VERSION=v1.36.6
# https://github.com/helm/helm/releases/tag/v3.22.1 (v3 on purpose: same major as Argo CD's embedded helm)
HELM_VERSION=v3.22.1
# https://github.com/kubernetes-sigs/kustomize/releases/tag/kustomize%2Fv5.8.3
KUSTOMIZE_VERSION=v5.8.3
# https://github.com/mikefarah/yq/releases/tag/v4.54.3
YQ_VERSION=v4.54.3
# https://github.com/yannh/kubeconform/releases/tag/v0.8.0
KUBECONFORM_VERSION=v0.8.0
# https://github.com/gitleaks/gitleaks/releases/tag/v8.30.1
GITLEAKS_VERSION=v8.30.1
# https://github.com/cilium/cilium-cli/releases/tag/v0.20.3
CILIUM_CLI_VERSION=v0.20.3
# https://github.com/cilium/hubble/releases/tag/v1.20.4
HUBBLE_CLI_VERSION=v1.20.4

# ---- Kubernetes (kind) -------------------------------------------------------------------------
# https://github.com/kubernetes-sigs/kind/releases/tag/v0.33.0 (node image digests in release notes)
# Cilium 1.20 e2e matrix: k8s 1.33-1.36 (Documentation/network/kubernetes/compatibility.rst @ v1.20.5)
KIND_NODE_VERSION=v1.36.4
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed

# ---- Platform (Helm charts) ------------------------------------------------------------------
# https://helm.cilium.io/index.yaml  (chart 1.20.5 / app 1.20.5, released 2026-11-17)
CILIUM_CHART_REPO=https://helm.cilium.io
CILIUM_CHART_VERSION=1.20.5
# Gateway API CRDs: version and channel dictated by Cilium 1.20.5 docs (conf.py gateway_api_version = v1.6.3).
# SPEC §5.1 said v1.6.1; v1.6.3 is the same-minor patch that Cilium 1.20.5 documents.
# https://github.com/kubernetes-sigs/gateway-api/releases/tag/v1.6.3
GATEWAY_API_VERSION=v1.6.3
GATEWAY_API_CHANNEL=standard
# https://argoproj.github.io/argo-helm/index.yaml  (chart 10.11.7 / app v3.5.7). Q5: stay on 3.5.x.
ARGOCD_CHART_REPO=https://argoproj.github.io/argo-helm
ARGOCD_CHART_VERSION=10.11.7
ARGOCD_VERSION=v3.5.7
# https://charts.jetstack.io/index.yaml
CERT_MANAGER_CHART_REPO=https://charts.jetstack.io
CERT_MANAGER_VERSION=v1.21.3

# ---- Observability (Helm charts) -------------------------------------------------------------
# https://prometheus-community.github.io/helm-charts/index.yaml
# CRDs chart 33.0.2 ships operator v0.95.2; kube-prometheus-stack 93.3.1 runs operator v0.95.2 (must match).
PROMETHEUS_CHART_REPO=https://prometheus-community.github.io/helm-charts
PROMETHEUS_OPERATOR_CRDS_CHART_VERSION=33.0.2
KUBE_PROMETHEUS_STACK_CHART_VERSION=93.3.1
# Loki / Tempo OSS charts moved to grafana-community (grafana/helm-charts READMEs: tempo after 2026-01-30,
# loki after 2026-03-16). The old grafana repo copies are deprecated / enterprise-only.
# Approved 2026-11-25 (SPEC §2.3/§5.1, ADR-0009).
# https://grafana-community.github.io/helm-charts/index.yaml
GRAFANA_COMMUNITY_CHART_REPO=https://grafana-community.github.io/helm-charts
LOKI_CHART_VERSION=21.3.1
LOKI_VERSION=3.7.10
TEMPO_CHART_VERSION=3.2.1
TEMPO_VERSION=3.1.1
# https://grafana.github.io/helm-charts/index.yaml (alloy is still published here, not deprecated)
GRAFANA_CHART_REPO=https://grafana.github.io/helm-charts
ALLOY_CHART_VERSION=1.16.0
ALLOY_VERSION=v1.22.0
# https://open-telemetry.github.io/opentelemetry-helm-charts/index.yaml (chart 0.178.3 / collector 0.163.2)
OTEL_CHART_REPO=https://open-telemetry.github.io/opentelemetry-helm-charts
OTEL_COLLECTOR_CHART_VERSION=0.178.3
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.163.2

# ---- Application -----------------------------------------------------------------------------
# https://github.com/GoogleCloudPlatform/microservices-demo/releases/tag/v0.10.7
BOUTIQUE_VERSION=v0.10.7
# registry used by release/kubernetes-manifests.yaml @ v0.10.7 (linux/amd64 only, single-arch manifests)
BOUTIQUE_IMAGE_REGISTRY=us-central1-docker.pkg.dev/online-boutique-ci/microservices-demo
# upstream manifest uses the floating `redis:alpine`; the overlay must replace it with this pin.
# https://hub.docker.com/_/redis/tags
REDIS_IMAGE=redis:8.12.0-alpine

# ---- Probe / debug images --------------------------------------------------------------------
# https://hub.docker.com/r/curlimages/curl/tags
CURL_IMAGE=curlimages/curl:8.22.0
# https://hub.docker.com/r/nicolaka/netshoot/tags
NETSHOOT_IMAGE=nicolaka/netshoot:v0.16
